{
  "output": "DSI-2",
  "display_refresh_hz": "auto",
  "animation_fps_cap": 120,
  "boot_animation_enabled": true,
  "boot_logo_path": "assets/branding/RiverBankco.png",
  "boot_min_seconds": 4.0,
  "boot_settle_seconds": 0.4,
  "boot_static_seconds": 0.6,
  "boot_fade_seconds": 1.0,
  "boot_failure_timeout": 45.0,
  "default_state": "idle",
  "background_mode": "black_chroma",
  "chroma_soft_distance": 36,
  "display_scale": 1.3,
  "touch_enabled": true,
  "touch_state": "poke_mouth",
  "touch_ttl_seconds": 2.5,
  "touch_debounce_seconds": 0.4,
  "long_press_seconds": 0.7,
  "radial_menu_idle_seconds": 2.0,
  "menu_deadzone_px": 72,
  "menu_background_blur": 50,
  "display_diameter_mm": 86.36,
  "radial_menu_offset_mm": 3.0,
  "volume_slider_idle_seconds": 1.0,
  "volume_slider_transition_seconds": 0.28,
  "settings_transition_seconds": 0.26,
  "pomodoro_transition_seconds": 0.28,
  "pomodoro_duration_hold_seconds": 0.45,
  "pomodoro_duration_adjust_seconds": 0.24,
  "pomodoro_title_font_path": "assets/fonts/MaShanZheng-Regular.ttf",
  "pomodoro_focus_minutes": 25,
  "pomodoro_short_break_minutes": 5,
  "pomodoro_long_break_minutes": 15,
  "pomodoro_long_break_every": 4,
  "music_library_dir": "/mnt/nvme64/Music",
  "music_player_command": "/usr/bin/cvlc",
  "music_transition_seconds": 0.28,
  "video_call_base_url": "http://127.0.0.1:19734",
  "video_call_view_fps": 20,
  "camera_snapshot_url": "http://127.0.0.1:19733/snapshot",
  "camera_view_fps": 30,
  "camera_gallery_dir": "${RIVERBANK_DATA}/camera/gallery",
  "camera_gallery_page_size": 6,
  "camera_controls_inward_mm": 5.0,
  "camera_indicator_angle_degrees": -45,
  "camera_indicator_edge_inset_px": 44,
  "cache_limit_mb": 2048,
  "camera_exit_edge_ratio": 0.8,
  "camera_exit_swipe_px": 100,
  "font_path": "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc",
  "status_font_path": "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc",
  "radial_menu": [
    {
      "id": "voice",
      "label": "对话",
      "glyph": "声",
      "action": {"type": "voice_trigger"}
    },
    {
      "id": "vision",
      "label": "相机",
      "glyph": "眼",
      "action": {"type": "camera_voice"}
    },
    {
      "id": "daily",
      "label": "日报",
      "glyph": "报",
      "action": {
        "type": "voice_query",
        "text": "请用口语简短告诉我今天的具身智讯日报里最值得关注的内容。"
      }
    },
    {
      "id": "settings",
      "label": "设置",
      "glyph": "设",
      "action": {"type": "open_settings"}
    },
    {
      "id": "app_pin",
      "label": "空位",
      "glyph": "+",
      "action": {"type": "open_app_menu"}
    },
    {
      "id": "applications",
      "label": "应用",
      "glyph": "应",
      "action": {"type": "open_app_menu"}
    }
  ],
  "application_menu": [
    {
      "id": "pomodoro",
      "label": "番茄",
      "glyph": "茄",
      "action": {"type": "launch_app", "app_id": "pomodoro"}
    },
    {
      "id": "performance",
      "label": "性能",
      "glyph": "能",
      "action": {"type": "launch_app", "app_id": "performance"}
    },
    {
      "id": "music",
      "label": "音乐",
      "glyph": "乐",
      "action": {"type": "launch_app", "app_id": "music"}
    },
    {
      "id": "video_call",
      "label": "通话",
      "glyph": "话",
      "action": {"type": "launch_app", "app_id": "video_call"}
    }
  ],
  "expressions": {
    "idle": "assets/expressions/01_idle.gif",
    "proud": "assets/expressions/02_proud.gif",
    "poke_mouth": "assets/expressions/03_poke_mouth.gif",
    "love": "assets/expressions/04_love.gif",
    "afraid": "assets/expressions/05_afraid.gif",
    "happy": "assets/expressions/06_happy.gif",
    "cry": "assets/expressions/07_cry.gif",
    "cool": "assets/expressions/08_cool.gif",
    "touch_nose": "assets/expressions/09_touch_nose.gif",
    "sad": "assets/expressions/10_sad.gif",
    "angry": "assets/expressions/11_angry.gif",
    "listening": "assets/expressions/12_listening.gif",
    "sleep": "assets/expressions/13_sleep.gif",
    "thinking": "assets/expressions/14_thinking.gif",
    "error": "assets/expressions/14_thinking.gif",
    "shutdown": "assets/expressions/15_shutdown.gif"
  }
}
