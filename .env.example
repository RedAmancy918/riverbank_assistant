# Never commit real values. Hermes may use these in its own profile directory.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Optional China-region Qwen Image overrides. The API key above is shared with
# the configured DashScope account; never place a real key in this file.
DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RIVERBANK_IMAGE_GENERATION_MODEL=qwen-image-3.0-pro
# RIVERBANK_IMAGE_GENERATION_SIZE=

# Optional runtime overrides used by RiverBank modules.
RIVERBANK_HOME=
RIVERBANK_DATA=
RIVERBANK_DAILY_HOME=
RIVERBANK_CAMERA_SNAPSHOT_URL=http://127.0.0.1:19733/snapshot
# Leave empty to use the PipeWire default input; otherwise set an exact node name.
RIVERBANK_AUDIO_SOURCE=
RIVERBANK_HTTP_PROXY=http://127.0.0.1:15732
