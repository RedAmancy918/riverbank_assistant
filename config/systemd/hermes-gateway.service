[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@RIVERBANK_USER@
Group=@RIVERBANK_USER@
ExecStart=@RIVERBANK_HOME@/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
WorkingDirectory=@RIVERBANK_HOME@/.hermes
Environment="HOME=@RIVERBANK_HOME@"
Environment="USER=@RIVERBANK_USER@"
Environment="LOGNAME=@RIVERBANK_USER@"
Environment="PATH=/usr/bin:@RIVERBANK_HOME@/.hermes/hermes-agent/venv/bin:@RIVERBANK_HOME@/.hermes/hermes-agent/node_modules/.bin:@RIVERBANK_HOME@/.local/bin:@RIVERBANK_HOME@/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=@RIVERBANK_HOME@/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=@RIVERBANK_HOME@/.hermes"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-@RIVERBANK_HOME@/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
