[Unit]
Description=Guarded Paper Radar catch-up
After=network-online.target hermes-gateway.service
Wants=network-online.target

[Service]
Slice=riverbank-apps.slice
Type=oneshot
User=@RIVERBANK_USER@
Group=@RIVERBANK_USER@
WorkingDirectory=@RIVERBANK_REPO@/apps/paper-radar
ExecStart=@RIVERBANK_REPO@/apps/paper-radar/.venv/bin/python @RIVERBANK_REPO@/apps/paper-radar/scripts/catchup.py --hermes @RIVERBANK_HOME@/.local/bin/hermes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@RIVERBANK_HOME@/.hermes @RIVERBANK_DATA@/paper-radar @RIVERBANK_REPO@/apps/paper-radar/data @RIVERBANK_REPO@/apps/paper-radar/reports @RIVERBANK_REPO@/apps/paper-radar/public
TimeoutStartSec=50min
StandardOutput=journal
StandardError=journal
