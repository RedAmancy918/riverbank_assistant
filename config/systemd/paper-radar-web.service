[Unit]
Description=Embodied Intelligence Daily web application
After=network-online.target riverbank-video-call.service riverbank-chat-worker.service
StartLimitIntervalSec=60
StartLimitBurst=5
Wants=network-online.target

[Service]
Slice=riverbank-apps.slice
Type=simple
User=@RIVERBANK_USER@
Group=@RIVERBANK_USER@
WorkingDirectory=@RIVERBANK_REPO@/apps/paper-radar
ExecStart=@RIVERBANK_REPO@/apps/paper-radar/.venv/bin/python @RIVERBANK_REPO@/apps/paper-radar/scripts/web_server.py --host 0.0.0.0 --port 19732
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@RIVERBANK_REPO@/apps/paper-radar/data/special-focus @RIVERBANK_REPO@/apps/paper-radar/data/paper-qa
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
