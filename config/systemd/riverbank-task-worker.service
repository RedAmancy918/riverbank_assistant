[Unit]
Description=RiverBank persistent background task worker
After=network-online.target riverbank-agent-runtime.service
StartLimitIntervalSec=60
StartLimitBurst=5
Wants=network-online.target
Requires=riverbank-agent-runtime.service

[Service]
Slice=riverbank-apps.slice
Type=simple
User=@RIVERBANK_USER@
Group=@RIVERBANK_USER@
WorkingDirectory=@RIVERBANK_REPO@/apps/video-call
Environment="HOME=@RIVERBANK_HOME@"
Environment="HERMES_HOME=@RIVERBANK_HOME@/.hermes/profiles/daily"
Environment="PYTHONPATH=@RIVERBANK_REPO@/apps/agent-runtime"
EnvironmentFile=-@RIVERBANK_HOME@/.hermes/.env
Environment="PYTHONUNBUFFERED=1"
Environment="http_proxy=http://127.0.0.1:15732"
Environment="https_proxy=http://127.0.0.1:15732"
Environment="no_proxy=127.0.0.1,localhost,riverbank-tech"
ExecStart=@RIVERBANK_REPO@/apps/video-call/.venv/bin/python @RIVERBANK_REPO@/apps/video-call/task_worker.py --db /var/lib/riverbank-tasks/tasks.db --reports-dir @RIVERBANK_HOME@/.hermes/profiles/daily/workspace/reports --workspace @RIVERBANK_HOME@/.hermes/profiles/daily/workspace --agent-transport socket --agent-socket /run/riverbank-agent/runtime.sock
Restart=on-failure
RestartSec=4
KillMode=control-group
TimeoutStopSec=12
StateDirectory=riverbank-tasks
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/lib/riverbank-tasks @RIVERBANK_HOME@/.hermes

[Install]
WantedBy=multi-user.target
