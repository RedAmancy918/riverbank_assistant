[Unit]
Description=RiverBank offline QR provisioning service
After=NetworkManager.service expression-display.service
Wants=NetworkManager.service expression-display.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=@RIVERBANK_USER@
RuntimeDirectory=riverbank-provisioning
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/python3 @RIVERBANK_REPO@/apps/provisioning/provisioning_service.py --config /etc/riverbank/provisioning.json --validate-config
ExecStart=/usr/bin/python3 @RIVERBANK_REPO@/apps/provisioning/provisioning_service.py --config /etc/riverbank/provisioning.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/riverbank-provisioning /etc/riverbank @RIVERBANK_HOME@/.hermes /etc/hostname /etc/NetworkManager/system-connections
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
